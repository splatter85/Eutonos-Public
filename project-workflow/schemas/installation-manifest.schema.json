{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tova.local/project-workflow/installation-manifest.schema.json",
  "title": "ToVA Project Workflow Installation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "workflow_version",
    "architecture_generation",
    "installed_at",
    "installer_version",
    "layout",
    "owners",
    "enabled_modules",
    "variant",
    "acceptance_evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "workflow_id": { "const": "tova-project-workflow" },
    "workflow_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "architecture_generation": { "const": 2 },
    "installed_at": { "type": "string", "format": "date-time" },
    "installer_version": { "type": "string", "minLength": 3 },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_root", "docs_root"],
      "properties": {
        "state_root": { "type": "string", "minLength": 2 },
        "docs_root": { "type": "string", "minLength": 2 }
      }
    },
    "owners": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": { "type": "string", "minLength": 2 }
    },
    "enabled_modules": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "variant": { "type": ["string", "null"] },
    "acceptance_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "accepted_at", "checks"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "accepted_at": { "type": "string", "format": "date-time" },
        "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } }
      }
    },
    "migration_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "accepted_at", "check"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "accepted_at": { "type": "string", "format": "date-time" },
        "check": { "const": "workflow:migration-check" }
      }
    }
  }
}
