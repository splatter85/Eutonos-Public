{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tova.local/project-workflow/module-manifest.schema.json",
  "title": "ToVA Project Workflow Optional Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "purpose",
    "admission",
    "non_goals",
    "installs",
    "extends",
    "health",
    "retirement",
    "examples"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "purpose": { "type": "string", "minLength": 20 },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria", "evidence"],
      "properties": {
        "criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }
      }
    },
    "non_goals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
    "installs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "commands"],
      "properties": {
        "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "commands": { "type": "array", "items": { "type": "string", "minLength": 3 } }
      }
    },
    "extends": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "command", "required"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "command": { "type": "string", "minLength": 3 },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    },
    "retirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remove", "preserve"],
      "properties": {
        "remove": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "preserve": { "type": "array", "items": { "type": "string", "minLength": 3 } }
      }
    },
    "examples": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }
  }
}
