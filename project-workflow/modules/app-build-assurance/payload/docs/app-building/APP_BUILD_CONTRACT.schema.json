{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tova.local/project-workflow/app-build-contract.schema.json",
  "title": "ToVA App Build Assurance Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "app",
    "workflows",
    "architecture",
    "data",
    "quality",
    "review",
    "constraints",
    "nonGoals",
    "openQuestions"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "tova.appBuildContract" },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "stage", "purpose", "primaryUsers", "targets"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 3 },
        "stage": { "enum": ["prototype", "mvp", "beta", "release"] },
        "purpose": { "type": "string", "minLength": 20 },
        "primaryUsers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "targets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } }
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "actor", "goal", "successCriteria", "acceptanceRefs"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "actor": { "type": "string", "minLength": 3 },
          "goal": { "type": "string", "minLength": 15 },
          "successCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
          "acceptanceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceOfTruth", "responsibilityBoundaries", "generatedArtifacts", "externalSystems"],
      "properties": {
        "sourceOfTruth": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["concern", "ownerRef"],
            "properties": {
              "concern": { "type": "string", "minLength": 5 },
              "ownerRef": { "type": "string", "minLength": 3 }
            }
          }
        },
        "responsibilityBoundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "responsibility", "ownerRefs"],
            "properties": {
              "id": { "type": "string", "minLength": 3 },
              "responsibility": { "type": "string", "minLength": 15 },
              "ownerRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }
            }
          }
        },
        "generatedArtifacts": { "type": "array", "items": { "type": "string", "minLength": 3 } },
        "externalSystems": { "type": "array", "items": { "type": "string", "minLength": 3 } }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models", "persistence", "migrationRisk", "backupRecovery", "syncConflictPolicy", "destructiveOperations"],
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "relationships"],
            "properties": {
              "id": { "type": "string", "minLength": 3 },
              "relationships": { "type": "array", "items": { "type": "string", "minLength": 3 } }
            }
          }
        },
        "persistence": { "enum": ["none", "in-memory", "local", "server", "hybrid"] },
        "migrationRisk": { "enum": ["none", "low", "medium", "high"] },
        "backupRecovery": { "type": "string", "minLength": 15 },
        "syncConflictPolicy": { "type": "string", "minLength": 15 },
        "destructiveOperations": { "type": "array", "items": { "type": "string", "minLength": 5 } }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errorAndEmptyStates", "performanceRisks", "securityPrivacyRisks", "testPlan"],
      "properties": {
        "errorAndEmptyStates": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
        "performanceRisks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
        "securityPrivacyRisks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
        "testPlan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "integration", "ui", "migration", "regression", "manualQa"],
          "properties": {
            "unit": { "$ref": "#/$defs/testEntry" },
            "integration": { "$ref": "#/$defs/testEntry" },
            "ui": { "$ref": "#/$defs/testEntry" },
            "migration": { "$ref": "#/$defs/testEntry" },
            "regression": { "$ref": "#/$defs/testEntry" },
            "manualQa": { "$ref": "#/$defs/testEntry" }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredLenses", "healthGate", "acceptanceRefs", "unresolvedAcceptance"],
      "properties": {
        "requiredLenses": {
          "type": "array",
          "minItems": 6,
          "items": { "enum": ["architecture", "data", "testing", "performance", "security-privacy", "product-workflow"] },
          "uniqueItems": true
        },
        "healthGate": { "enum": ["Quick", "Standard", "Full"] },
        "acceptanceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "unresolvedAcceptance": { "type": "array", "items": { "type": "string", "minLength": 5 } }
      }
    },
    "constraints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
    "nonGoals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
    "openQuestions": { "type": "array", "items": { "type": "string", "minLength": 5 } }
  },
  "$defs": {
    "testEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidenceRefs", "reason"],
      "properties": {
        "status": { "enum": ["not-applicable", "planned", "passed", "blocked"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 3 } },
        "reason": { "type": "string" }
      }
    }
  }
}
